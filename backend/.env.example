# ── MongoDB Atlas ──────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/gadgetglam?retryWrites=true&w=majority
# Seed database: npm run seed  (full reset)  |  npm run seed:analytics  (add analytics data only)

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# ── Server ─────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Frontend URL (for CORS) ────────────────────────────────
CLIENT_URL=http://localhost:3000

# ── JazzCash ───────────────────────────────────────────────
JAZZCASH_ENV=sandbox
# In sandbox mode, keep this true to simulate successful payment locally
JAZZCASH_SANDBOX_LOCAL=true

# ── OpenAI (AI Assistant) ──────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ── AI Provider (OpenAI or Gemini) ─────────────────────────
# Set AI_PROVIDER=openai or AI_PROVIDER=gemini
AI_PROVIDER=openai
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# ── AliExpress Affiliate ───────────────────────────────────
ALIEXPRESS_APP_KEY=your_aliexpress_app_key
ALIEXPRESS_SECRET=your_aliexpress_secret
ALIEXPRESS_TRACKING_ID=your_tracking_id
